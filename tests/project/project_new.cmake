# sbx new → sbx check → (SERVER 가 있으면) SandboxServer --world 로 몇 틱 (v0.2 M1-T4, ADR-0043).
#   cmake -DSBX=<sbx> -DOUT=<새 프로젝트 폴더> [-DFROM=<시나리오>] [-DSERVER=<SandboxServer> -DTICKS=<n>] -P project_new.cmake
# 같은 폴더에 다시 new 하면 실패해야 한다 (덮어쓰지 않는다).
foreach(v SBX OUT)
    if(NOT DEFINED ${v})
        message(FATAL_ERROR "${v} 가 필요합니다")
    endif()
endforeach()
file(REMOVE_RECURSE "${OUT}")
set(fromArgs)
if(DEFINED FROM)
    set(fromArgs --from "${FROM}")
endif()
execute_process(COMMAND "${SBX}" new "${OUT}" --id ctest.newgame --name "새 게임" ${fromArgs}
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
message("${out}${err}")
if(NOT rc EQUAL 0 OR NOT out MATCHES "프로젝트를 만들었습니다: .* ctest\\.newgame 0\\.1\\.0 \"새 게임\"")
    message(FATAL_ERROR "sbx new 실패 (종료 코드 ${rc})")
endif()
execute_process(COMMAND "${SBX}" check "${OUT}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
message("${out}${err}")
if(NOT rc EQUAL 0 OR NOT out MATCHES "프로젝트 검사: 오류 0, 경고 0 [^\n]*시작 월드 열림")
    message(FATAL_ERROR "새 프로젝트가 검사를 통과하지 못했습니다 (종료 코드 ${rc})")
endif()
execute_process(COMMAND "${SBX}" new "${OUT}" --id ctest.again RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(rc EQUAL 0 OR NOT err MATCHES "비어 있지 않습니다")
    message(FATAL_ERROR "비어 있지 않은 폴더에 new 가 성공했습니다")
endif()
if(DEFINED SERVER)
    execute_process(COMMAND "${SERVER}" --world "${OUT}" --port 0 --ticks ${TICKS} --exit --log-level warn
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
    message("${out}${err}")
    if(NOT rc EQUAL 0 OR NOT out MATCHES "world 새 게임 .*tick ${TICKS} hash 0x")
        message(FATAL_ERROR "서버가 새 프로젝트를 돌리지 못했습니다 (종료 코드 ${rc})")
    endif()
endif()
file(REMOVE_RECURSE "${OUT}")
