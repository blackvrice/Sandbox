# Studio GUI smoke (v0.8 NG-07 층 3 — docs/28-CREATOR-UX-GATES.md 3.1, ADR-0120): 실제 창 · 렌더러 (Windows D3D12 WARP — GPU 없이도) 로
#   1. 홈 (--world 없이) N 프레임, 2. 워크스페이스 (프로젝트 · 개발자 창까지 모든 창) N 프레임 — 종료 코드 0 · "[error]" 줄 없음 · 렌더러가 실제로
#   그렸다 ("렌더러 스프라이트 …") · 끝날 때 배치가 저장됐다 (도킹 창). 창 · 렌더러를 만들 수 없으면 (디스플레이 · 디바이스 없음) "건너뜀" 을
#   찍는다 — CTest SKIP_REGULAR_EXPRESSION (통과로 적지 않는다).
#   cmake -DCLIENT=<SandboxClient> -DSBX=<sbx> -DOUT=<작업 폴더> -P studio_gui_smoke.cmake
foreach(v CLIENT SBX OUT)
    if(NOT DEFINED ${v})
        message(FATAL_ERROR "${v} 가 필요합니다")
    endif()
endforeach()
# 실제 창을 띄운다 — 사람이 쓰는 PC 에서는 포커스를 빼앗을 수 있어 CI (GitHub Actions — CI=true) 또는 SBX_GUI_TESTS=1 일 때만.
# 아니면 "건너뜀" (통과로 적지 않는다)
if(NOT "$ENV{CI}" STREQUAL "true" AND NOT "$ENV{SBX_GUI_TESTS}" STREQUAL "1")
    message("studio_gui_smoke: 건너뜀 (CI · SBX_GUI_TESTS=1 이 아니다 — 창을 띄우지 않는다)")
    return()
endif()
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}/config")
set(ENV{SBX_CONFIG_DIR} "${OUT}/config")
# 개발자 창까지 그린다 (모든 패널의 그리기 길)
file(WRITE "${OUT}/config/studio.json" [=[{"schemaVersion": 1, "developerPanels": true}]=])
set(game "${OUT}/Smoke")
execute_process(COMMAND "${SBX}" new "${game}" --id ctest.smoke --from ecosystem_small RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "sbx new 실패 (${rc})")
endif()

function(gui what)
    execute_process(COMMAND "${CLIENT}" --rhi-warp --width 1366 --height 768 --autosave-seconds 0 ${ARGN}
        RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e TIMEOUT 300)
    set(all "${o}${e}")
    message("${what} → ${rc}\n${all}")
    # 창 · 렌더러를 만들 수 없는 곳 (디스플레이 없는 세션 · 디바이스 없음) — 실패가 아니라 건너뜀
    if(all MATCHES "렌더러 없음" OR all MATCHES "CreateWindowExW 실패" OR all MATCHES "RegisterClassExW 실패"
       OR all MATCHES "렌더러 없이 계속합니다")
        message("${what}: 창 · 렌더러를 만들 수 없다 — 건너뜀")
        file(WRITE "${OUT}/skipped" "${what}")
        return()
    endif()
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${what}: 종료 코드 ${rc}")
    endif()
    if(all MATCHES "\\[error\\]")
        message(FATAL_ERROR "${what}: 오류 줄이 있다")
    endif()
    if(NOT all MATCHES "렌더러 스프라이트")
        message(FATAL_ERROR "${what}: 렌더러가 그리지 않았다")
    endif()
    set(last "${all}" PARENT_SCOPE)
endfunction()

gui("홈" --frames 90)
if(EXISTS "${OUT}/skipped")
    message("studio_gui_smoke: 건너뜀 (창 · 렌더러 없음)") # CTest SKIP_REGULAR_EXPRESSION — 통과로 적지 않는다
    return()
endif()
if(NOT last MATCHES "frames 90")
    message(FATAL_ERROR "홈: 90 프레임을 돌지 않았다")
endif()
gui("워크스페이스 (모든 창)" --world "${game}" --frames 180)
if(NOT last MATCHES "frames 180")
    message(FATAL_ERROR "워크스페이스: 180 프레임을 돌지 않았다")
endif()
file(GLOB layouts "${OUT}/config/studio/layouts/*.ini")
if(NOT layouts)
    message(FATAL_ERROR "끝날 때 배치를 저장하지 않았다")
endif()
list(GET layouts 0 ini)
file(READ "${ini}" text)
foreach(w "목록" "인스펙터" "콘솔" "통계")
    if(NOT text MATCHES "\\[Window\\]\\[${w}\\]")
        message(FATAL_ERROR "배치에 '${w}' 창이 없다 — 그리지 않았다")
    endif()
endforeach()
message("studio_gui_smoke: 통과")
