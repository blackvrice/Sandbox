# 프로젝트 에셋 (v0.6 M6-T9 · NG-12, ADR-0090 · 0097): sbx new (ecosystem_small — 서버가 틱을 돈다) → assets/ 에 파일 → sbx check (A2 경고 — id 없음) → sbx build 거절 →
# sbx asset import (.meta) → sbx build (형식 3 — 에셋 실음) → sbx check <패키지> (에셋 id 1) → 서버가 패키지로 돈다 → .meta 째 복사하고
# 내용을 고치면 sbx check 오류 A3 (고르지 않음) → sbx asset newid 로 고침 → 경고 · 오류 0
#   cmake -DSBX=<sbx> -DSERVER=<SandboxServer> -DOUT=<작업 폴더> -P project_assets.cmake
foreach(v SBX SERVER OUT)
    if(NOT DEFINED ${v})
        message(FATAL_ERROR "${v} 가 필요합니다")
    endif()
endforeach()
file(REMOVE_RECURSE "${OUT}")
set(game "${OUT}/Art")

function(run expect what)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e TIMEOUT 120)
    message("${what} → ${rc}\n${o}${e}")
    if(NOT rc EQUAL ${expect})
        message(FATAL_ERROR "${what}: 종료 코드 ${rc} (기대 ${expect})")
    endif()
    set(last "${o}${e}" PARENT_SCOPE)
endfunction()

run(0 "sbx new" "${SBX}" new "${game}" --id ctest.art --from ecosystem_small)
file(WRITE "${game}/assets/art/hero.png" "PNG-hero")
run(0 "sbx check (id 없음 — 경고)" "${SBX}" check "${game}")
if(NOT last MATCHES "A2" OR NOT last MATCHES "에셋: id 0 · id 없음 1")
    message(FATAL_ERROR "A2 경고 · 에셋 요약이 없다")
endif()
run(2 "sbx build (id 없는 에셋)" "${SBX}" build "${game}" --out "${OUT}/no.sbpkg")
if(NOT last MATCHES "sbx asset import")
    message(FATAL_ERROR "build 거절 문장에 sbx asset import 가 없다")
endif()
run(0 "sbx asset import" "${SBX}" asset import "${game}")
if(NOT last MATCHES "\\.meta 를 썼습니다: 1 개" OR NOT EXISTS "${game}/assets/art/hero.png.meta")
    message(FATAL_ERROR ".meta 를 쓰지 않았다")
endif()
run(0 "sbx check (에셋 id 1)" "${SBX}" check "${game}")
if(NOT last MATCHES "에셋: id 1 · id 없음 0" OR NOT last MATCHES "오류 0, 경고 0")
    message(FATAL_ERROR "가져온 뒤에도 경고가 있다")
endif()
run(0 "sbx build (형식 3)" "${SBX}" build "${game}" --out "${OUT}/art.sbpkg")
run(0 "sbx check <패키지>" "${SBX}" check "${OUT}/art.sbpkg")
if(NOT last MATCHES "에셋: id 1 · id 없음 0" OR NOT last MATCHES "오류 0, 경고 0")
    message(FATAL_ERROR "패키지의 에셋이 그대로가 아니다")
endif()
run(0 "서버 (패키지)" "${SERVER}" --world "${OUT}/art.sbpkg" --port 0 --ticks 5 --exit --log-level warn)

# 복사한 뒤 고친 그림 — .meta 도 함께 복사됐다
file(COPY_FILE "${game}/assets/art/hero.png.meta" "${game}/assets/art/hero_red.png.meta")
file(WRITE "${game}/assets/art/hero_red.png" "PNG-red")
run(1 "sbx check (A3)" "${SBX}" check "${game}")
if(NOT last MATCHES "A3")
    message(FATAL_ERROR "같은 id · 다른 내용이 A3 이 아니다")
endif()
run(2 "sbx build (A3)" "${SBX}" build "${game}" --out "${OUT}/clash.sbpkg")
run(0 "sbx asset newid" "${SBX}" asset newid "${game}" assets/art/hero_red.png)
if(NOT last MATCHES "새 id [0-9a-f]+")
    message(FATAL_ERROR "새 id 줄이 없다")
endif()
run(0 "sbx check (고친 뒤)" "${SBX}" check "${game}")
if(NOT last MATCHES "에셋: id 2 · id 없음 0" OR NOT last MATCHES "오류 0, 경고 0")
    message(FATAL_ERROR "newid 뒤에도 문제가 있다")
endif()
file(REMOVE_RECURSE "${OUT}")
message("project_assets OK")
