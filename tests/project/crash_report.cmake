# 충돌 보고 (v0.5 M1-T1 — docs/20-CREATOR-ALPHA.md 7.1): 실행 파일을 --crash-test 로 일부러 충돌시키고 (SBX_REPORTS_DIR 아래)
# 보고 묶음 하나가 남는지 — report.json (이유 · 버전) · log.txt (마지막 로그 — "--crash-test" 줄), Windows 는 crash.dmp,
# 소유자 열쇠 · 사용자 폴더가 묶음 어디에도 없다. 종료 코드는 0 이 아니어야 한다.
#   cmake -DEXE=<SandboxServer | SandboxClient> -DAPP=<이름> -DOUT=<작업 폴더> "-DARGS=a;b;…" -P crash_report.cmake
foreach(v EXE APP OUT)
    if(NOT DEFINED ${v})
        message(FATAL_ERROR "${v} 가 필요합니다")
    endif()
endforeach()
file(REMOVE_RECURSE "${OUT}")
set(secret "SECRETKEY123")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "SBX_REPORTS_DIR=${OUT}/reports"
    "${EXE}" ${ARGS} --crash-test --log-level info
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
message("종료 코드 ${rc}\n${out}${err}")
if(rc EQUAL 0)
    message(FATAL_ERROR "--crash-test 인데 정상 종료했다")
endif()
if(NOT "${out}${err}" MATCHES "충돌 보고: ")
    message(FATAL_ERROR "충돌 보고 줄이 없다")
endif()
file(GLOB dirs LIST_DIRECTORIES true "${OUT}/reports/*-${APP}")
list(LENGTH dirs n)
if(NOT n EQUAL 1)
    message(FATAL_ERROR "보고 묶음이 하나가 아니다 (${n})")
endif()
list(GET dirs 0 dir)
file(READ "${dir}/report.json" report)
file(READ "${dir}/log.txt" log)
message("report.json:\n${report}")
if(NOT report MATCHES "\"app\": \"${APP}\"" OR NOT report MATCHES "\"version\": \"[0-9]+\\.[0-9]+\\.[0-9]+\"")
    message(FATAL_ERROR "report.json 의 앱 · 버전이 없다")
endif()
if(WIN32)
    if(NOT report MATCHES "access violation" OR NOT EXISTS "${dir}/crash.dmp" OR NOT report MATCHES "crash\\.dmp")
        message(FATAL_ERROR "Windows: 예외 이름 · 미니덤프가 없다")
    endif()
elseif(NOT report MATCHES "SIGSEGV")
    message(FATAL_ERROR "POSIX: SIGSEGV 가 아니다")
endif()
if(NOT log MATCHES "--crash-test: 일부러")
    message(FATAL_ERROR "log.txt 에 마지막 로그 줄이 없다")
endif()
# 민감정보: 소유자 열쇠 (서버 · 클라이언트 모두 명령줄에 넣는다) · 사용자 폴더
foreach(text IN ITEMS "${report}" "${log}")
    if(text MATCHES "${secret}")
        message(FATAL_ERROR "보고 묶음에 소유자 열쇠가 남았다")
    endif()
    foreach(home IN ITEMS "$ENV{USERPROFILE}" "$ENV{HOME}")
        if(NOT home STREQUAL "")
            string(REPLACE "\\" "\\\\" homeJson "${home}")
            string(FIND "${text}" "${home}" a)
            string(FIND "${text}" "${homeJson}" b)
            if(NOT a EQUAL -1 OR NOT b EQUAL -1)
                message(FATAL_ERROR "보고 묶음에 사용자 폴더가 남았다")
            endif()
        endif()
    endforeach()
endforeach()
if(NOT report MATCHES "<SECRET>")
    message(FATAL_ERROR "소유자 열쇠 자리에 <SECRET> 이 없다")
endif()
file(REMOVE_RECURSE "${OUT}")
