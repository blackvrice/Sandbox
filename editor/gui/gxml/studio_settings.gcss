/* Studio 설정 (UI-R2-02) — Studio 어두운 테마와 같은 계열 (editor/ui/StudioTheme · StudioHomeScreen 의 색). 토큰 공유는 UI-R2-03 */
:root {
  --surface: #181A1E;
  --ink: #E8EAEE;
  --muted: #969CA8;
  --neutral: #3C404A;
  --accent: #3A6EDC;
  background-color: var(--surface);
  color: var(--ink);
  font-id: resource(ui-font);
  font-size: 15px;
}
Panel#main { padding: 28px 32px; gap: 10px; }
FlexPanel { gap: 8px; }
.title { font-size: 26px; }
.status { color: #78C88C; font-size: 14px; }
.label { color: var(--muted); font-size: 14px; }
.note { color: var(--muted); font-size: 13px; }
Button { width: 120px; height: 34px; background-color: var(--neutral); }
Button.wide { width: 220px; }
Button:hover { background-color: #4C515D; }
Button:pressed { background-color: #2C2F37; }
Button:focus { background-color: #4C515D; }
Button.primary { background-color: var(--accent); }
Button.primary:hover { background-color: #4E82F0; }
