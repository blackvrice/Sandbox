{
  "id": "eco.hud",
  "layer": "hud",
  "root": {
    "kind": "panel", "id": "top",
    "anchor": { "min": [0, 0], "max": [1, 0] }, "offset": [8, 8, -8, 48],
    "style": "eco.bar", "stack": "row", "gap": 8, "padding": 4, "align": "center",
    "children": [
      { "kind": "image", "material": "eco/rabbit", "size": [24, 24] },
      { "kind": "text", "id": "score", "text": "@eco.hud.score", "args": [{ "bind": "var:eco.rabbits" }, { "bind": "session:score[0]" }] },
      { "kind": "progress", "id": "energy", "value": { "bind": "component:life.energy.value@selected" },
        "max": { "bind": "component:life.energy.max@selected" }, "size": [160, 16], "style": "eco.meter" },
      { "kind": "button", "id": "feed", "text": "@eco.hud.feed", "style": "eco.button", "on": { "click": { "action": "eco.feed" } } },
      { "kind": "button", "id": "trap", "text": "@eco.hud.trap", "style": "eco.button", "on": { "click": { "action": "eco.trap" } } },
      { "kind": "button", "id": "help-toggle", "text": "?", "on": { "click": { "ui": "toggle", "target": "eco.hud.help" } } },
      { "kind": "text", "id": "help", "text": "@eco.hud.help", "overflow": "fit" }
    ]
  }
}
