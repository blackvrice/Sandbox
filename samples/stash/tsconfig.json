{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@inventory/*": [".sandbox/packages/inventory/scripts/*"],
      "@stash/*": ["content/stash/scripts/*"]
    }
  },
  "include": ["sdk/sandbox.d.ts", "content/*/scripts/**/*.ts", ".sandbox/packages/*/scripts/**/*.ts"]
}
