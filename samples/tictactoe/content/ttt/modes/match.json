{
  "id": "ttt.match",
  "name": "틱택토",
  "description": "3 × 3 판에 X 를 두어 줄을 먼저 만들면 승리 — 상대 (O) 는 서버 스크립트. 버튼 · 신호 ttt.place (칸 0 ~ 8)",
  "players": { "min": 1, "max": 1 },
  "start": { "countdownSeconds": 0 },
  "end": [
    { "when": { "count": { "tags": { "all": ["victory"] }, "op": ">=", "value": 1 } }, "result": "win" },
    { "when": { "count": { "tags": { "all": ["defeat"] }, "op": ">=", "value": 1 } }, "result": "lose" },
    { "when": { "count": { "tags": { "all": ["draw"] }, "op": ">=", "value": 1 } }, "result": "draw" }
  ],
  "restart": { "mode": "manual" }
}
