# 내장 셰이더 원본을 C++ 헤더로 (ADR-0171). Graphics SDK 어댑터가 D3D12 에서 shaders/*.hlsl 를 그대로 (FXC SM 5.1 로) 컴파일하고,
# Vulkan 용 생성 SPIR-V (tools/shader/gen_gfxsdk_spirv.py) 가 어느 원본에서 왔는지 견준다 — 셰이더 원본은 shaders/ 하나뿐.
#
#   sbx_embed_hlsl(OUTPUT <헤더> SOURCE_DIR <shaders> NAMES basic_color sprite …)
#     헤더에 이름마다 k<Pascal>Hlsl (std::string_view — `#include "common/X"` 줄을 그 파일 내용으로 바꾼 글, 줄 끝 LF) 와
#     k<Pascal>HlslSha256 (그 글의 SHA-256 — 생성기가 같은 방식으로 계산한다) 을 쓴다. 구성 때 만들고, 원본이 바뀌면 다시 구성한다.
include_guard(GLOBAL)

function(_sbx_hlsl_inline_text path dir out_var)
    file(READ "${path}" text)
    string(REPLACE "\r\n" "\n" text "${text}")
    # #include "common/…" 한 단계 (Common.hlsli 는 다른 파일을 include 하지 않는다)
    string(REGEX MATCHALL "#include \"common/[A-Za-z0-9_]+\\.hlsli\"" includes "${text}")
    list(REMOVE_DUPLICATES includes)
    foreach(inc IN LISTS includes)
        string(REGEX REPLACE "#include \"(common/[A-Za-z0-9_]+\\.hlsli)\"" "\\1" rel "${inc}")
        file(READ "${dir}/${rel}" inc_text)
        string(REPLACE "\r\n" "\n" inc_text "${inc_text}")
        string(REPLACE "${inc}" "${inc_text}" text "${text}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${dir}/${rel}")
    endforeach()
    set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(sbx_embed_hlsl)
    cmake_parse_arguments(A "" "OUTPUT;SOURCE_DIR" "NAMES" ${ARGN})
    set(body "#pragma once\n// 자동 생성 — cmake/SbxEmbedHlsl.cmake (ADR-0171). 고치지 말고 shaders/*.hlsl 를 고친다.\n#include <string_view>\n\nnamespace sbx::rhi::graphics_sdk::hlsl_sources {\n\n")
    foreach(name IN LISTS A_NAMES)
        set(path "${A_SOURCE_DIR}/${name}.hlsl")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
        _sbx_hlsl_inline_text("${path}" "${A_SOURCE_DIR}" text)
        string(SHA256 sha "${text}")
        # basic_color → BasicColor
        string(REPLACE "_" ";" parts "${name}")
        set(pascal "")
        foreach(p IN LISTS parts)
            string(SUBSTRING "${p}" 0 1 head)
            string(SUBSTRING "${p}" 1 -1 tail)
            string(TOUPPER "${head}" head)
            string(APPEND pascal "${head}${tail}")
        endforeach()
        string(LENGTH "${text}" len)
        if(len GREATER 16000)
            message(FATAL_ERROR "shaders/${name}.hlsl 가 16000 바이트를 넘는다 — MSVC 문자열 리터럴 한도 (C2026)")
        endif()
        string(APPEND body "inline constexpr std::string_view k${pascal}Hlsl = R\"sbxhlsl(${text})sbxhlsl\";\n")
        string(APPEND body "inline constexpr std::string_view k${pascal}HlslSha256 = \"${sha}\";\n\n")
    endforeach()
    string(APPEND body "} // namespace sbx::rhi::graphics_sdk::hlsl_sources\n")
    # 같은 내용이면 쓰지 않는다 (불필요한 재컴파일 없음)
    if(EXISTS "${A_OUTPUT}")
        file(READ "${A_OUTPUT}" old)
    endif()
    if(NOT old STREQUAL body)
        file(WRITE "${A_OUTPUT}" "${body}")
    endif()
endfunction()
